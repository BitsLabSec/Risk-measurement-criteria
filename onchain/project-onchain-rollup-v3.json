{
  "id": "project-onchain-rollup-v3",
  "version": "1.0",
  "effectiveDate": "2026-11-25",
  "status": "current",
  "basis": ["评分骨架.md v1.0 §3", "onchain/链上安全评估标准.md v1.0 §8"],
  "supersedes": ["archive/project-onchain-rollup-v1.json", "archive/project-onchain-rollup-v2.json"],
  "dimensionWeights": {
    "permissions": 0.4,
    "configuration": 0.3,
    "funds_dependencies": 0.3
  },
  "checkResultValues": [100, 90, 60, 0, "N/A", "incomplete", "reference"],
  "permissionScoreTable": {
    "single_key": { "delay_lt_24h": 0, "delay_24h_to_48h": 40, "delay_ge_48h": 50 },
    "two_or_more_keys": { "delay_lt_24h": 80, "delay_24h_to_48h": 85, "delay_ge_48h": 95 },
    "capability_absent_verified": 100
  },
  "calculation": {
    "dimensionScore": "min(该业务该大项下各适用检查项的 result)。N/A 和 reference 不参与；任一检查为 incomplete，则该大项为 incomplete。",
    "businessScore": "Σ(大项分 × 大项权重) ÷ Σ(适用大项权重)。N/A 或只有 reference 的大项不计入权重。",
    "fatalItems": ["X1", "X2", "X3"],
    "businessFinalScore": "命中任一已证实的致命项时为 0，否则等于 businessScore。",
    "businessWeight": "max(业务 TVL ÷ 项目总 TVL, 0.05)，然后在所有业务间归一。拿不到 TVL 时各业务等权，并记录 tvl_unavailable。",
    "projectScore": "Σ(businessFinalScore × businessWeight)",
    "projectDimensionDisplay": "Σ(业务大项分 × businessWeight)，只用于展示，计算时不考虑致命项。",
    "incompletePropagation": "任一业务为 incomplete，项目结果为 incomplete，不发布分数。",
    "rounding": { "intermediate": "unrounded", "display": 2, "mode": "half_up" },
    "passThreshold": "大于 60 为及格"
  },
  "resultSchema": {
    "assessment": {
      "assessment_id": "string",
      "project": "string",
      "rule_versions": { "skeleton": "1.0", "onchain": "1.0", "specialties": { "<专项名>": "<版本>" } },
      "baseline_id": "前期准备中的部署基线 ID",
      "snapshots": [{ "chain": "string", "block_or_checkpoint": "string", "hash": "string", "time": "ISO8601" }],
      "target_count": "integer，最多 50",
      "businesses": ["business"],
      "project_result": {
        "status": "rated | incomplete",
        "score": "number | null",
        "dimension_display": { "permissions": "number", "configuration": "number", "funds_dependencies": "number" },
        "incomplete_items": ["check_id"]
      }
    },
    "business": {
      "business_id": "string",
      "specialty": "string",
      "tvl_usd": "number | null",
      "tvl_source": "string",
      "weight": "number",
      "required_operations": ["string"],
      "checks": ["check"],
      "dimension_scores": { "permissions": "number | N/A | incomplete", "configuration": "...", "funds_dependencies": "..." },
      "business_score": "number | null",
      "fatal_items": [{ "id": "X1 | X2 | X3", "evidence": ["url"], "reason": "string" }],
      "business_final_score": "number | null"
    },
    "check": {
      "check_id": "H1 | H2 | H3 | C1 | C2 | C3 | F1 | F2 | D1 | D2 | 专项子项编号",
      "dimension": "permissions | configuration | funds_dependencies",
      "objects": [{ "chain": "string", "address_or_object_id": "string", "field": "string" }],
      "raw_values": [{ "name": "string", "value": "string", "unit": "string" }],
      "formula": "string | null",
      "rule": "例如 onchain-v1.0 §4.2 + lending-v1.0 L-C2.1",
      "result": "100 | 90 | 60 | 0 | N/A | incomplete | reference",
      "reference_to": "check_id | null",
      "reason": "string",
      "evidence": ["url"],
      "permission_path": {
        "path": "string，例如 AdminCap -> 2/3 多签 -> upgrade",
        "min_distinct_keys": "integer",
        "effective_delay_hours": "number",
        "note": "只在权限检查项中填写"
      }
    }
  }
}
